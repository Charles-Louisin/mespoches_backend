# MongoDB
MONGODB_URI=

# Auth (jamais côté frontend)
JWT_SECRET=
# Aligné sur le cookie web (12 h). Ne pas mettre 7d sans changer TOKEN_MAX_AGE.
JWT_EXPIRES_IN=12h

# Serveur
PORT=5000
NODE_ENV=production

# Pool Mongo (une connexion process, réutilisée)
MONGO_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_QUERY_MAX_MS=12000
REQUEST_TIMEOUT_MS=20000
SLOW_REQUEST_MS=500
OPENROUTER_TIMEOUT_MS=90000
AI_REQUEST_TIMEOUT_MS=90000

# Frontend (CORS + pages retour CinetPay — HTTPS obligatoire en prod)
# Liste d’origines séparées par des virgules (OBLIGATOIRE en production)
CORS_ORIGIN=https://votre-domaine.com
APP_URL=https://votre-domaine.com

# URL publique HTTPS de cette API (webhook : …/api/webhooks/cinetpay)
API_PUBLIC_URL=https://api.votre-domaine.com

# Secret pour GET /api/cinetpay-setup et /api/health?cinetpay=1
# Header uniquement: X-Setup-Secret: ...
CINETPAY_SETUP_SECRET=
# CinetPay v1 — compte marchand Cameroun (XAF)
# production → api.cinetpay.co | sandbox → api.cinetpay.net
# Liste blanche IP : IP SORTANTE du serveur qui héberge ce backend (voir /api/subscription/cinetpay-setup)
CINETPAY_ENV=production
CINETPAY_ACCOUNT_KEY=
CINETPAY_ACCOUNT_PASSWORD=

# Google OAuth (connexion prioritaire)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=MES POCHES <noreply@votre-domaine.com>
RESEND_REPLY_TO=

# GEMINI_API_KEY=  (déprécié — remplacé par OpenRouter)

# OpenAI payant (scan + dictée + Whisper). Si présent, utilisé en premier.
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_WHISPER_MODEL=whisper-1
# OPENAI_TIMEOUT_MS=90000
# AI_REQUEST_TIMEOUT_MS=90000

# OpenRouter (analyse images + notifications + voix) — modèles PAYANTS uniquement
OPENROUTER_API_KEY=
# Ne pas mettre de suffixe :free (ignoré). Défauts payants si vide :
# OPENROUTER_VISION_MODEL_1=google/gemini-2.5-flash
# OPENROUTER_VISION_MODEL_2=openai/gpt-4o-mini
# OPENROUTER_VISION_MODEL_3=google/gemini-2.0-flash-001
# OPENROUTER_TEXT_MODEL_1=openai/gpt-4o-mini
# OPENROUTER_TEXT_MODEL_2=google/gemini-2.5-flash
# OPENROUTER_TEXT_MODEL_3=google/gemini-2.0-flash-001
# OPENROUTER_WHISPER_MODEL=openai/whisper-large-v3
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_APP_NAME=MES POCHES

# Notifications / dépenses prévues (cron UTC — optionnel)
# PLANNED_EXPENSE_REMINDER_HOUR_UTC=8
# PLANNED_EXPENSE_EXECUTE_HOUR_UTC=0
# PLANNED_EXPENSE_EXECUTE_MINUTE_UTC=5

# UploadThing (optionnel)
UPLOADTHING_TOKEN=
