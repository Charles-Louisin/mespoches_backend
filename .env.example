# MongoDB
MONGODB_URI=

# Auth (jamais côté frontend)
JWT_SECRET=
# Aligné sur le cookie web (12 h). Ne pas mettre 7d sans changer TOKEN_MAX_AGE.
JWT_EXPIRES_IN=12h

# Serveur
PORT=5000
NODE_ENV=production

# Pool Mongo (une connexion process, réutilisée)
MONGO_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_QUERY_MAX_MS=12000
REQUEST_TIMEOUT_MS=20000
SLOW_REQUEST_MS=500
OPENROUTER_TIMEOUT_MS=90000
AI_REQUEST_TIMEOUT_MS=90000

# Liste d’origines séparées par des virgules (OBLIGATOIRE en production)
CORS_ORIGIN=https://votre-domaine.com
APP_URL=https://votre-domaine.com

API_PUBLIC_URL=https://api.votre-domaine.com

# Secret ops (header X-Setup-Secret) pour GET /api/saspay-setup et /api/metrics
# Header uniquement: X-Setup-Secret: ...
OPS_SETUP_SECRET=

# Google OAuth (connexion prioritaire)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend) — adresses du domaine, jamais un Gmail personnel
RESEND_API_KEY=
RESEND_FROM_EMAIL=MES POCHES <noreply@mespoches.store>
RESEND_REPLY_TO=contact@mespoches.store

# GEMINI_API_KEY=  (déprécié — remplacé par OpenRouter)

# OpenAI payant (scan + dictée + Whisper). Si présent, utilisé en premier.
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_WHISPER_MODEL=whisper-1
# OPENAI_TIMEOUT_MS=90000
# AI_REQUEST_TIMEOUT_MS=90000

# OpenRouter — 4 modèles PAYANTS (sans :free)
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=google/gemini-2.0-flash-001
OPENROUTER_WHISPER_MODEL=openai/whisper-large-v3
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_APP_NAME=MES POCHES

# Notifications / dépenses prévues (cron UTC — optionnel)
# PLANNED_EXPENSE_REMINDER_HOUR_UTC=8
# PLANNED_EXPENSE_EXECUTE_HOUR_UTC=0
# PLANNED_EXPENSE_EXECUTE_MINUTE_UTC=5

# UploadThing (optionnel)
UPLOADTHING_TOKEN=

# sk_test_… en développement, sk_live_… en production (backend uniquement)
SASPAY_SECRET_KEY=
# Secret de signature du webhook (tableau de bord → Webhooks) ; URL : <API>/webhooks/saspay
SASPAY_WEBHOOK_SECRET=
# ADD_ON (défaut) : frais payés par le client, le marchand reçoit le prix affiché. DEDUCTED : frais déduits.
SASPAY_FEE_CHARGE_MODE=ADD_ON
